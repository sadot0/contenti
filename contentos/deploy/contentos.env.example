# Скопируй в ~/.contentos.env (в домашнюю папку) и заполни.
# Этот файл подхватывается автозапуском (deploy/run_daily.sh).

# Telegram-уведомления (бот от @BotFather, chat_id от @userinfobot)
export CONTENTOS_TG_TOKEN=
export CONTENTOS_TG_CHAT=

# Необязательно — переопределить параметры цикла:
# export CONTENTOS_DIR="$HOME/contenti/contentos"
# export CONTENTOS_MODEL="qwen2.5:14b-instruct"
# export CONTENTOS_NET="instagram"
# export CONTENTOS_IDEAS="3"
